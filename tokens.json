{
  "color": {
    "neutral": {
      "1000": { "$type": "color", "$value": "#000000", "$description": "畫布底色" },
      "950": { "$type": "color", "$value": "#111212", "$description": "卡片/導覽深底。收斂自原稿另一個近似值 #131519（見 ds-state.md 決策紀錄）" },
      "800": { "$type": "color", "$value": "#313131", "$description": "圖表柱體實色" }
    },
    "white": {
      "$type": "color",
      "$value": "#ffffff",
      "alpha-90": { "$type": "color", "$value": "#ffffffe5" },
      "alpha-80": { "$type": "color", "$value": "#ffffffcc", "$description": "收斂自原稿 #d9d9d9（走馬燈啟用點）" },
      "alpha-60": { "$type": "color", "$value": "#ffffff99" },
      "alpha-50": { "$type": "color", "$value": "#ffffff80", "$description": "收斂自原稿 #858585（底部導覽未選取）" },
      "alpha-40": { "$type": "color", "$value": "#ffffff66" },
      "alpha-30": { "$type": "color", "$value": "#ffffff4d" },
      "alpha-20": { "$type": "color", "$value": "#ffffff33" },
      "alpha-10": { "$type": "color", "$value": "#ffffff1a" },
      "alpha-5": { "$type": "color", "$value": "#ffffff0d" }
    },
    "lime": {
      "500": { "$type": "color", "$value": "#dbfd5c", "$description": "品牌強調色" },
      "500-alpha-30": { "$type": "color", "$value": "#dbfd5c4d", "$description": "品牌色 30% 疊加，獨立定義，不與 white-alpha 系列混用" },
      "400": { "$type": "color", "$value": "#c8e840", "$description": "互動「選中態」專用色，刻意與 lime-500 分開定義" }
    },
    "teal": {
      "500": { "$type": "color", "$value": "#46ccb9", "$description": "金融方向性：上漲/多單/買入。不與 success 混用" }
    },
    "pink": {
      "500": { "$type": "color", "$value": "#ff41a3", "$description": "金融方向性：下跌/空單/賣出。不與 danger 混用" }
    },

    "bg": {
      "canvas": { "$type": "color", "$value": "{color.neutral.1000}" },
      "surface": { "$type": "color", "$value": "{color.neutral.950}", "$description": "導覽列、底部導覽背景" },
      "surface-raised": { "$type": "color", "$value": "{color.white.alpha-5}", "$description": "卡片底" },
      "surface-subtle": { "$type": "color", "$value": "{color.white.alpha-10}" },
      "surface-emphasis": { "$type": "color", "$value": "{color.white.alpha-20}", "$description": "Severity badge 底" },
      "accent": { "$type": "color", "$value": "{color.lime.500}" },
      "accent-subtle": { "$type": "color", "$value": "{color.lime.500-alpha-30}", "$description": "當前使用者高亮列（Leaderboard）" },
      "nav": { "$type": "color", "$value": "{color.neutral.950}" },
      "chart-bar": { "$type": "color", "$value": "{color.neutral.800}" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.white}" },
      "secondary": { "$type": "color", "$value": "{color.white.alpha-90}" },
      "tertiary": { "$type": "color", "$value": "{color.white.alpha-50}", "$description": "亦收斂原「底部導覽未選取」#858585 用色" },
      "quaternary": { "$type": "color", "$value": "{color.white.alpha-40}" },
      "disabled": { "$type": "color", "$value": "{color.white.alpha-30}" },
      "brand": { "$type": "color", "$value": "{color.lime.500}" },
      "selected": { "$type": "color", "$value": "{color.lime.400}", "$description": "篩選 tab 選中態文字，與 brand 分開定義" },
      "positive": { "$type": "color", "$value": "{color.teal.500}" },
      "negative": { "$type": "color", "$value": "{color.pink.500}" }
    },
    "icon": {
      "primary": { "$type": "color", "$value": "{color.white}" },
      "tertiary": { "$type": "color", "$value": "{color.white.alpha-50}" },
      "disabled": { "$type": "color", "$value": "{color.white.alpha-30}" }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "{color.white.alpha-5}" },
      "default": { "$type": "color", "$value": "{color.white.alpha-10}" },
      "strong": { "$type": "color", "$value": "{color.white.alpha-30}" },
      "accent": { "$type": "color", "$value": "{color.lime.500}" }
    }
  },

  "gradient": {
    "button-primary": {
      "$type": "gradient",
      "$value": [
        { "color": "#7053f3", "position": 0 },
        { "color": "#76bab2", "position": 0.55 },
        { "color": "#e3ff94", "position": 1 }
      ],
      "$description": "Add funds / Ask Trade DNA 按鈕底，獨立定義，非核心調色盤"
    },
    "text-brand-a": {
      "$type": "gradient",
      "$value": [
        { "color": "#b09eff", "position": 0 },
        { "color": "#76bab2", "position": 0.6 },
        { "color": "#e3ff94", "position": 1 }
      ],
      "$description": "Points System 標題文字漸層"
    },
    "text-brand-b": {
      "$type": "gradient",
      "$value": [
        { "color": "#c4b7ff", "position": 0 },
        { "color": "#76bab2", "position": 0.63 },
        { "color": "#e3ff94", "position": 1 }
      ],
      "$description": "AI insight 標籤文字漸層。⚠ 與 text-brand-a 起始色微差，未強制收斂，見未解決事項"
    }
  },

  "space": {
    "050": { "$type": "dimension", "$value": "4px" },
    "075": { "$type": "dimension", "$value": "6px", "$description": "⚠ 離群值，建議之後併入 100" },
    "100": { "$type": "dimension", "$value": "8px" },
    "150": { "$type": "dimension", "$value": "12px" },
    "200": { "$type": "dimension", "$value": "16px" },
    "250": { "$type": "dimension", "$value": "20px" },
    "300": { "$type": "dimension", "$value": "24px" },
    "500": { "$type": "dimension", "$value": "40px" },

    "inset": {
      "sm": { "$type": "dimension", "$value": "{space.100}" },
      "md": { "$type": "dimension", "$value": "{space.150}" },
      "lg": { "$type": "dimension", "$value": "{space.200}" }
    },
    "stack": {
      "sm": { "$type": "dimension", "$value": "{space.050}" },
      "md": { "$type": "dimension", "$value": "{space.100}" },
      "lg": { "$type": "dimension", "$value": "{space.200}" }
    },
    "inline": {
      "sm": { "$type": "dimension", "$value": "{space.050}" },
      "md": { "$type": "dimension", "$value": "{space.100}" },
      "lg": { "$type": "dimension", "$value": "{space.200}" }
    },
    "gutter": {
      "md": { "$type": "dimension", "$value": "{space.200}" },
      "lg": { "$type": "dimension", "$value": "{space.300}" }
    }
  },

  "radius": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "6px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "999px" }
  },

  "font": {
    "family": {
      "heading": { "$type": "fontFamily", "$value": "Poppins" },
      "body": { "$type": "fontFamily", "$value": "Poppins" },
      "data": { "$type": "fontFamily", "$value": "Manrope", "$description": "⚠ 新發現，Trade/Assets 頁部分數字標籤使用，獨立定義，未確認是否刻意" },
      "system": { "$type": "fontFamily", "$value": "SF Pro Text", "$description": "僅 StatusBar 系統元件使用，不進自訂元件 token" }
    },
    "size": {
      "050": { "$type": "dimension", "$value": "10px" },
      "100": { "$type": "dimension", "$value": "12px" },
      "150": { "$type": "dimension", "$value": "13px" },
      "200": { "$type": "dimension", "$value": "14px" },
      "300": { "$type": "dimension", "$value": "16px" },
      "400": { "$type": "dimension", "$value": "20px" },
      "500": { "$type": "dimension", "$value": "24px" },
      "700": { "$type": "dimension", "$value": "28px" }
    },
    "weight": {
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "100": { "$type": "dimension", "$value": "12px" },
      "150": { "$type": "dimension", "$value": "14px" },
      "200": { "$type": "dimension", "$value": "16px" },
      "250": { "$type": "dimension", "$value": "18px" },
      "300": { "$type": "dimension", "$value": "20px" },
      "400": { "$type": "dimension", "$value": "24px" },
      "500": { "$type": "dimension", "$value": "28px" }
    }
  },

  "component": {
    "button": {
      "primary": {
        "bg-default": { "$type": "gradient", "$value": "{gradient.button-primary}" },
        "text": { "$type": "color", "$value": "{color.white}" },
        "radius": { "$type": "dimension", "$value": "{radius.md}" },
        "bg-disabled": { "$type": "color", "$value": "{color.bg.surface-subtle}", "$description": "❌ 未設計，估計值" }
      },
      "outline": {
        "border-default": { "$type": "color", "$value": "{color.border.strong}" },
        "text-default": { "$type": "color", "$value": "{color.text.tertiary}" }
      }
    },
    "tab": {
      "pill": {
        "bg-selected": { "$type": "color", "$value": "{color.bg.surface-subtle}" },
        "text-selected": { "$type": "color", "$value": "{color.text.primary}" },
        "text-default": { "$type": "color", "$value": "{color.text.secondary}" },
        "opacity-inactive": { "$type": "number", "$value": 0.5 }
      },
      "underline": {
        "text-selected": { "$type": "color", "$value": "{color.text.primary}" },
        "text-selected-filter": { "$type": "color", "$value": "{color.text.selected}", "$description": "Markets 篩選列選中態，獨立於一般 underline tab" },
        "text-default": { "$type": "color", "$value": "{color.text.tertiary}" },
        "indicator-bg": { "$type": "color", "$value": "{color.text.brand}" }
      }
    },
    "card": {
      "bg": { "$type": "color", "$value": "{color.bg.surface-raised}" },
      "radius": { "$type": "dimension", "$value": "{radius.lg}" },
      "padding": { "$type": "dimension", "$value": "{space.inset.md}" }
    },
    "stat-card": {
      "outlined": {
        "border": { "$type": "color", "$value": "{color.border.default}" },
        "radius": { "$type": "dimension", "$value": "{radius.md}" }
      },
      "plain": {
        "border": { "$type": "color", "$value": "{color.border.subtle}" }
      },
      "label": { "$type": "color", "$value": "{color.text.tertiary}" },
      "value": { "$type": "color", "$value": "{color.text.primary}" },
      "annotation-positive": { "$type": "color", "$value": "{color.text.positive}" }
    },
    "badge": {
      "severity": {
        "bg-medium": { "$type": "color", "$value": "{color.bg.surface-emphasis}" },
        "text-medium": { "$type": "color", "$value": "{color.text.primary}" },
        "bg-low": { "$type": "color", "$value": null, "$description": "❌ 未設計" },
        "bg-high": { "$type": "color", "$value": null, "$description": "❌ 未設計" }
      }
    },
    "tag": {
      "behavioral": {
        "bg": { "$type": "color", "$value": "{color.bg.surface-raised}" },
        "border": { "$type": "color", "$value": "{color.border.default}" },
        "text": { "$type": "color", "$value": "{color.text.secondary}" }
      },
      "direction": {
        "text-long": { "$type": "color", "$value": "{color.text.positive}" },
        "text-short": { "$type": "color", "$value": "{color.text.negative}" },
        "bg": { "$type": "color", "$value": "{color.bg.surface-subtle}" }
      }
    },
    "nav-item": {
      "icon-selected": { "$type": "color", "$value": "{color.text.primary}" },
      "label-selected": { "$type": "color", "$value": "{color.text.primary}" },
      "icon-default": { "$type": "color", "$value": "{color.text.tertiary}" },
      "label-default": { "$type": "color", "$value": "{color.text.tertiary}" }
    },
    "list-row": {
      "divider": { "$type": "color", "$value": "{color.border.subtle}" },
      "bg-selected": { "$type": "color", "$value": "{color.bg.accent-subtle}" },
      "value-positive": { "$type": "color", "$value": "{color.text.positive}" },
      "value-negative": { "$type": "color", "$value": "{color.text.negative}" }
    },
    "input": {
      "bg": { "$type": "color", "$value": "{color.bg.surface-subtle}" },
      "border-default": { "$type": "color", "$value": "{color.border.default}" },
      "text-placeholder": { "$type": "color", "$value": "{color.text.tertiary}" },
      "border-focus": { "$type": "color", "$value": null, "$description": "❌ 未設計" },
      "border-error": { "$type": "color", "$value": null, "$description": "❌ 未設計" }
    },
    "chart": {
      "bar-default": { "$type": "color", "$value": "{color.bg.chart-bar}" },
      "bar-highlight": { "$type": "gradient", "$value": "{gradient.button-primary}", "$description": "依資料決定，非固定樣式" },
      "axis-label": { "$type": "color", "$value": "{color.text.tertiary}" },
      "axis-label-emphasis": { "$type": "color", "$value": "{color.text.primary}" }
    }
  }
}
